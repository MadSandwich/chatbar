<Bindings>
    <Binding name="CHATBAR_TOGGLE" category="BINDING_HEADER_CHATBAR">
        ChatBar_ToggleBar()
    </Binding>
    <Binding name="CHATBAR_SWITCH_SAY" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("SAY")
    </Binding>
    <Binding name="CHATBAR_SWITCH_YELL" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("YELL")
    </Binding>
    <Binding name="CHATBAR_SWITCH_EMOTE" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("EMOTE")
    </Binding>
    <Binding name="CHATBAR_SWITCH_WHISPER" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("WHISPER")
    </Binding>
    <Binding name="CHATBAR_SWITCH_BN_WHISPER" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("BN_WHISPER")
    </Binding>
    <Binding name="CHATBAR_SWITCH_PARTY" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("PARTY")
    </Binding>
    <Binding name="CHATBAR_SWITCH_RAID" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("RAID")
    </Binding>
    <Binding name="CHATBAR_SWITCH_GUILD" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("GUILD")
    </Binding>
    <Binding name="CHATBAR_SWITCH_OFFICER" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("OFFICER")
    </Binding>
    <Binding name="CHATBAR_SWITCH_BATTLEGROUND" category="BINDING_HEADER_CHATBAR">
        ChatBar_SwitchToChannel("BATTLEGROUND")
    </Binding>
    <Binding name="CHATBAR_CYCLE_PREV" category="BINDING_HEADER_CHATBAR">
        ChatBar_CycleChannel(1)
    </Binding>
    <Binding name="CHATBAR_CYCLE_NEXT" category="BINDING_HEADER_CHATBAR">
        ChatBar_CycleChannel(-1)
    </Binding>
</Bindings>
